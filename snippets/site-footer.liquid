{% assign footer_year = 'now' | date: '%Y' %}
<footer class="site-footer mt-auto bg-[#F5F5F0] bg-no-repeat bg-bottom bg-[length:100%_auto] text-[#333333] z-[50]" role="contentinfo" aria-label="{{ 'footer.aria_label' | t }}" style="--footer-pad-x: 40px;{% if settings.footer_watermark_image != blank %} background-image: url('{{ settings.footer_watermark_image | image_url: width: 2400 }}');{% endif %}">
    <div class="mx-auto px-20 pb-6 pt-20">
      <div class="grid grid-cols-1 gap-14 md:grid-cols-2 xl:grid-cols-4">
        <div class="site-footer__col site-footer__col--news max-w-[300px]">
          <h2 class="text-lg font-bold uppercase text-[#333333]">{{ 'footer.newsletter_heading' | t }}</h2>
          {% form 'customer', class: 'mt-6' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="sr-only" for="footer-newsletter-email">{{ 'footer.newsletter_email_label' | t }}</label>
            <div class="site-footer__field flex overflow-hidden rounded-lg bg-[#E6E6E1]">
              <input
                id="footer-newsletter-email"
                name="contact[email]"
                type="email"
                autocomplete="email"
                placeholder="{{ 'footer.newsletter_placeholder' | t }}"
                class="site-footer__input min-w-0 flex-1 border-0 bg-transparent px-4 py-3.5 text-sm text-[#333333] placeholder:text-neutral-500 outline-none"
                required
              >
              <button type="submit" class="site-footer__submit flex shrink-0 items-center justify-center px-4 text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.newsletter_submit_aria' | t }}">
                <img src="{{ 'icons/right-arrow.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-5 invert">
              </button>
            </div>
          {% endform %}
          <p class="mt-3 max-w-sm text-base leading-relaxed text-neutral-600">
            {{ 'footer.newsletter_description' | t }}
          </p>
          <ul class="mt-10 flex flex-wrap items-center gap-6" aria-label="{{ 'footer.social_aria' | t }}">
            <li>
              <a href="#" class="text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.social_facebook' | t }}">
                <img src="{{ 'icons/facebook.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-5">
              </a>
            </li>
            <li>
              <a href="#" class="text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.social_instagram' | t }}">
                <img src="{{ 'icons/instagram.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-5">
              </a>
            </li>
            <li>
              <a href="#" class="text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.social_x' | t }}">
                <img src="{{ 'icons/x.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-5">
              </a>
            </li>
            <li>
              <a href="#" class="text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.social_youtube' | t }}">
                <img src="{{ 'icons/youtube.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-6">
              </a>
            </li>
          </ul>
          <p class="mt-3 text-[10px] font-normal uppercase tracking-wide text-neutral-500">{{ 'footer.social_accounts_caption' | t }}</p>
        </div>

        {% if settings.footer_menu_primary != blank %}
          {% assign footer_menu_primary_obj = linklists[settings.footer_menu_primary] %}
          {% if footer_menu_primary_obj.links.size > 0 %}
            <nav class="site-footer__col px-10" aria-label="{{ footer_menu_primary_obj.title | escape }}">
              <h3 class="text-lg font-bold uppercase text-[#333333]">{{ footer_menu_primary_obj.title | escape }}</h3>
              <ul class="mt-6 space-y-3 text-base font-normal text-[#333333]">
                {% for link in footer_menu_primary_obj.links %}
                  <li>
                    <a href="{{ link.url }}" class="transition-opacity hover:opacity-70">{{ link.title | escape }}</a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
        {% endif %}

        {% if settings.footer_menu_secondary != blank %}
          {% assign footer_menu_secondary_obj = linklists[settings.footer_menu_secondary] %}
          {% if footer_menu_secondary_obj.links.size > 0 %}
            <nav class="site-footer__col px-10" aria-label="{{ footer_menu_secondary_obj.title | escape }}">
              <h3 class="text-lg font-bold uppercase text-[#333333]">{{ footer_menu_secondary_obj.title | escape }}</h3>
              <ul class="mt-6 space-y-3 text-base font-normal text-[#333333]">
                {% for link in footer_menu_secondary_obj.links %}
                  <li>
                    <a href="{{ link.url }}" class="transition-opacity hover:opacity-70">{{ link.title | escape }}</a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
        {% endif %}

        {% if settings.footer_menu_tertiary != blank %}
          {% assign footer_menu_tertiary_obj = linklists[settings.footer_menu_tertiary] %}
          {% if footer_menu_tertiary_obj.links.size > 0 %}
            <nav class="site-footer__col px-10" aria-label="{{ footer_menu_tertiary_obj.title | escape }}">
              <h3 class="text-lg font-bold uppercase text-[#333333]">{{ footer_menu_tertiary_obj.title | escape }}</h3>
              <ul class="mt-6 space-y-3 text-base font-normal text-[#333333]">
                {% for link in footer_menu_tertiary_obj.links %}
                  <li>
                    <a href="{{ link.url }}" class="transition-opacity hover:opacity-70">{{ link.title | escape }}</a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
        {% endif %}
      </div>

      <div class="relative overflow-hidden text-center mt-24">
        <div class="relative z-[1] flex flex-col items-center mb-5">
          <img
            src="{{ 'icons/logo-prava.svg' | asset_url }}"
            width="200"
            height="48"
            alt="{{ shop.name | escape }}"
            class="h-auto w-[min(100%,300px)] brightness-0"
          >
          <p class="mt-5 text-base font-medium">{{ 'footer.tagline_since' | t: year: '1983' }}</p>
        </div>
      </div>

      <div class="site-footer__legal mt-4 flex flex-col gap-6 border-t border-[#333333]/18 pt-8 md:mt-6 md:flex-row md:items-center md:justify-between md:gap-8">
        <p class="text-xs text-[#333333]/85 md:text-sm"><b>{{ 'footer.copyright' | t: year: footer_year, shop_name: shop.name }}</b></p>
        <nav aria-label="{{ 'footer.legal_nav_aria' | t }}">
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs md:justify-end md:text-sm">
            <li><a href="#" class="text-[#333333] decoration-[#333333]/35 underline-offset-4 transition-opacity hover:opacity-70">{{ 'footer.legal_information_society' | t }}</a></li>
            <li><a href="#" class="text-[#333333] decoration-[#333333]/35 underline-offset-4 transition-opacity hover:opacity-70">{{ 'footer.legal_cookies' | t }}</a></li>
            <li><a href="#" class="text-[#333333] decoration-[#333333]/35 underline-offset-4 transition-opacity hover:opacity-70">{{ 'footer.legal_kvkk' | t }}</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </footer>
