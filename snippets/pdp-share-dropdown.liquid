{% comment %}
  Ürün PDP paylaşım menüsü (Shopify vitrin yaygın URL kalıpları):

  • Facebook — https://www.facebook.com/sharer.php?u= (topluluk / eski Shopify örnekleri)
  • X (Tweet) — https://twitter.com/intent/tweet?text=&url= (Twitter / X Web Intent; x.com’a yönlenir)
  • WhatsApp — https://wa.me/?text= (Meta / WhatsApp paylaşım formatı)

  Görseller: assets/icons/*.svg (asset_url)
{% endcomment %}
{% liquid
  assign share_abs_url = request.origin | append: product.url
%}
{% capture share_body_plain -%}{{ product.title }} {{ share_abs_url }}{%- endcapture %}
{% assign wa_segment = share_body_plain | url_escape %}
{% assign whatsapp_link = 'https://wa.me/?text=' | append: wa_segment %}
{% assign fb_u = share_abs_url | url_escape %}
{% assign facebook_link = 'https://www.facebook.com/sharer.php?u=' | append: fb_u %}
{% assign xt = product.title | url_escape %}
{% assign xu = share_abs_url | url_escape %}
{% assign x_link = 'https://twitter.com/intent/tweet?text=' | append: xt | append: '&url=' | append: xu %}
<div class="relative prava-pdp-share-dropdown">
  <details class="relative group/details">
    <summary
      class="inline-flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-neutral-700 marker:content-none [&::-webkit-details-marker]:hidden transition-colors hover:bg-neutral-200/50 hover:text-neutral-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
      aria-label="{{ 'products.share_aria' | t }}"
    >
      <span class="sr-only">{{ 'products.share' | t }}</span>
      <img
        src="{{ 'icons/pdp-share-upload.svg' | asset_url }}"
        alt=""
        class="pointer-events-none h-7 w-7"
        width="32"
        height="32"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      >
    </summary>
    <div
      role="presentation"
      class="absolute right-0 z-[5] mt-2 min-w-[14.5rem] max-w-[min(100vw-1.25rem,16rem)] origin-top-right rounded-2xl border border-neutral-200/70 bg-white/95 px-2 py-2.5 shadow-[0_18px_50px_-12px_rgba(0,0,0,0.18)] ring-1 ring-neutral-950/[0.04] backdrop-blur-md"
      id="Details-PdpShare-Panel-{{ section_id }}"
    >
      <nav aria-label="{{ 'products.share_nav_aria' | t }}" class="flex flex-col">
        <p
          class="px-2 pb-2 text-[11px] font-semibold uppercase leading-none tracking-[0.14em] text-neutral-400"
          aria-hidden="true"
        >
          {{ 'products.share' | t }}
        </p>
        <ul role="list" class="flex flex-col gap-0.5">
          <li class="m-0 p-0 list-none">
            <a
              href="{{ whatsapp_link }}"
              class="prava-share-row group flex items-center gap-3 rounded-xl px-2 py-2 text-left outline-none ring-neutral-900/10 transition-colors duration-200 hover:bg-neutral-100 active:bg-neutral-100/90 focus-visible:ring-2"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#dcf8dc]/95 ring-1 ring-[#128c49]/15"
                aria-hidden="true"
              >
                <img
                  src="{{ 'icons/whatsapp.svg' | asset_url }}"
                  width="20"
                  height="20"
                  alt=""
                  class="pointer-events-none h-5 w-5 shrink-0"
                  loading="lazy"
                  decoding="async"
                >
              </span>
              <span class="flex-1 text-[13px] font-medium tracking-tight text-neutral-700 group-hover:text-neutral-900">
                {{ 'products.share_whatsapp' | t }}
              </span>
            </a>
          </li>
          <li class="m-0 p-0 list-none">
            <a
              href="{{ facebook_link }}"
              class="prava-share-row group flex items-center gap-3 rounded-xl px-2 py-2 text-left outline-none ring-neutral-900/10 transition-colors duration-200 hover:bg-neutral-100 active:bg-neutral-100/90 focus-visible:ring-2"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50/90 ring-1 ring-blue-200/55"
                aria-hidden="true"
              >
                <img
                  src="{{ 'icons/facebook.svg' | asset_url }}"
                  width="20"
                  height="20"
                  alt=""
                  class="pointer-events-none h-[18px] w-[18px] shrink-0"
                  loading="lazy"
                  decoding="async"
                >
              </span>
              <span class="flex-1 text-[13px] font-medium tracking-tight text-neutral-700 group-hover:text-neutral-900">
                {{ 'products.share_facebook' | t }}
              </span>
            </a>
          </li>
          <li class="m-0 p-0 list-none">
            <a
              href="{{ x_link }}"
              class="prava-share-row group flex items-center gap-3 rounded-xl px-2 py-2 text-left outline-none ring-neutral-900/10 transition-colors duration-200 hover:bg-neutral-100 active:bg-neutral-100/90 focus-visible:ring-2"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-neutral-100 ring-1 ring-neutral-900/8"
                aria-hidden="true"
              >
                <img
                  src="{{ 'icons/x.svg' | asset_url }}"
                  width="20"
                  height="20"
                  alt=""
                  class="pointer-events-none h-[15px] w-[15px] shrink-0"
                  loading="lazy"
                  decoding="async"
                >
              </span>
              <span class="flex-1 text-[13px] font-medium tracking-tight text-neutral-700 group-hover:text-neutral-900">
                {{ 'products.share_x' | t }}
              </span>
            </a>
          </li>
        </ul>
        <div class="mx-2 my-2 h-px bg-neutral-200" role="presentation" aria-hidden="true"></div>
        <button
          type="button"
          class="prava-share-row group flex w-full cursor-pointer items-center gap-3 rounded-xl px-2 py-2 text-left outline-none ring-neutral-900/10 transition-colors duration-200 hover:bg-neutral-100 active:bg-neutral-100/90 focus-visible:ring-2"
          data-prava-share-copy
          data-share-url="{{ share_abs_url | escape }}"
        >
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-neutral-100 ring-1 ring-neutral-900/8"
            aria-hidden="true"
          >
            <img
              src="{{ 'icons/share-copy.svg' | asset_url }}"
              width="20"
              height="20"
              alt=""
              class="pointer-events-none h-5 w-5 shrink-0"
              loading="lazy"
              decoding="async"
            >
          </span>
          <span class="flex-1 text-[13px] font-medium tracking-tight text-neutral-700 group-hover:text-neutral-900">
            {{ 'products.share_copy' | t }}
          </span>
        </button>
      </nav>
    </div>
  </details>
</div>
