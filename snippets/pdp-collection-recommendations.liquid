{% comment %}
  pdp-collection-recommendations
  Ürünün ilk koleksiyonundan, kendisi hariç öneri ürünleri listeler.
{% endcomment %}

{% assign current_collection = product.collections.first %}
{% assign rec_limit = limit | default: 8 %}
{% assign shown = 0 %}
{% assign available_count = 0 %}

{% if current_collection %}
  {% for rec in current_collection.products %}
    {% if rec.id != product.id %}
      {% assign available_count = available_count | plus: 1 %}
      {% if available_count >= rec_limit %}
        {% break %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if available_count > 0 %}
    <div class="mt-24">
      <h2 class="text-3xl font-medium tracking-tight text-neutral-900 md:text-4xl">
        {{ 'sections.product_detail.related_products_title' | t }}
      </h2>

      <ul class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4" aria-label="{{ current_collection.title | escape }} ürünleri">
        {% for rec in current_collection.products %}
          {% if rec.id != product.id and shown < rec_limit %}
            <li class="overflow-hidden rounded-lg bg-white">
              <a href="{{ rec.url }}" class="group block">
                {% if rec.featured_image != blank %}
                  <img
                    src="{{ rec.featured_image | image_url: width: 640 }}"
                    alt="{{ rec.featured_image.alt | default: rec.title | escape }}"
                    loading="lazy"
                    width="320"
                    height="320"
                    class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                  >
                {% endif %}
                <div class="p-3 md:p-4">
                  <p class="line-clamp-2 text-sm text-neutral-900 md:text-base">{{ rec.title | escape }}</p>
                  <p class="mt-2 text-sm font-medium text-neutral-800">{{ rec.price | money }}</p>
                </div>
              </a>
            </li>
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}
{% endif %}
