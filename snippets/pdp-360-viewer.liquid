{% comment %}
  Ürün 360° görünüm — product.metafields.custom.images_360 (dosya listesi).
  JS: Cloudimage 360 View (layout’ta yüklenir; assets/js/main.js init).
{% endcomment %}
{% liquid
  assign images_360 = product.metafields.custom.images_360.value
  assign sorted_images = images_360 | sort: 'image.src'
  assign has_frames = false
  if sorted_images != blank and sorted_images.size > 0
    assign has_frames = true
  endif
%}

{% if has_frames %}
  <section
    class="prava-pdp-360 mt-28"
    data-prava-pdp-360
    aria-label="{{ 'products.view_360' | t }}"
  >
    <h2 class="text-center text-2xl font-medium text-neutral-900 md:text-4xl">
      {{ 'products.view_360' | t }}
    </h2>

    <div class="relative mx-auto mt-10 !max-w-[720px]">
      {% comment %} Zemin elipsi (tasarım ipucu) {% endcomment %}
      <div
        class="pointer-events-none absolute bottom-[8%] left-1/2 z-0 h-[18%] w-[72%] -translate-x-1/2 rounded-[50%] border border-neutral-300/80 bg-neutral-200/30 md:bottom-[6%] md:h-[20%] md:w-[68%]"
        aria-hidden="true"
      ></div>

      <div
        id="Pdp360Viewer-{{ section_id }}"
        class="cloudimage-360 prava-ci360 relative z-[1] mx-auto w-full max-w-[720px] overflow-hidden"
        data-prava-pdp-360-root
        style="aspect-ratio: 3 / 4;"
      ></div>

      <script type="application/json" class="prava-pdp-360__payload" hidden>
        {%- capture frames_payload -%}
          {%- assign has_written_item = false -%}
          {%- for file in sorted_images -%}
            {%- assign img = file.image | default: file -%}
            {%- if img != blank -%}
              {%- if has_written_item -%},{%- endif -%}
              {{- img | image_url: width: 1200 | json -}}
              {%- assign has_written_item = true -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        [{{- frames_payload | strip -}}]
      </script>
    </div>
  </section>
{% endif %}
