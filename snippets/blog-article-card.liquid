{% liquid
  assign post = article
  assign uid = title_id | strip
  if uid == blank and post != blank
    assign uid = 'blog-teaser-' | append: post.id
  endif
  if uid == blank
    assign uid = 'blog-teaser-card'
  endif

  assign img_loading = image_loading | default: 'lazy'

  assign card_excerpt = ''
  if post != blank
    assign card_excerpt = post.excerpt | strip_html | strip
    if card_excerpt == blank
      assign card_excerpt = post.content | strip_html | strip | truncate: 220
    endif
  endif
%}
{% if post != blank %}
  <a
    href="{{ post.url }}"
    class="prava-blog-card group flex h-full flex-col overflow-hidden rounded-sm bg-white shadow-sm ring-1 ring-black/[0.04] transition-shadow hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
    {% if block %}{{ block.shopify_attributes }}{% endif %}
  >
    <div class="aspect-[1/1] w-full overflow-hidden bg-neutral-100">
      {% if post.image != blank %}
        <img
          src="{{ post.image | image_url: width: 900 }}"
          alt="{{ post.image.alt | default: post.title | escape }}"
          class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
          width="640"
          height="400"
          loading="{{ img_loading }}"
          decoding="async"
          aria-labelledby="{{ uid }}"
        >
      {% endif %}
    </div>
    <div class="flex flex-1 flex-col p-6 md:p-8">
      <h3 id="{{ uid }}" class="text-lg font-medium leading-snug tracking-tight text-neutral-900 md:text-xl">
        {{ post.title }}
      </h3>
      {% if card_excerpt != blank %}
        <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-neutral-600 md:text-[15px]">
          {{ card_excerpt | escape }}
        </p>
      {% endif %}
    </div>
  </a>
{% elsif request.design_mode and block %}
  <div
    class="flex min-h-[200px] flex-col items-center justify-center rounded-sm border-2 border-dashed border-neutral-300 bg-white p-6 text-center"
    {{ block.shopify_attributes }}
  >
    <p class="m-0 text-sm text-neutral-500">Blog yazısı seçin</p>
  </div>
{% endif %}
