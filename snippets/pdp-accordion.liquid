{% capture dimensions_item %}
  {% render 'pdp-dimensions', product: product %}
{% endcapture %}
{% capture features_item %}
  {% render 'pdp-features', product: product %}
{% endcapture %}

{% if dimensions_item != blank or features_item != blank %}
  <div class="mt-16 rounded-xl bg-[#ebe9e6] px-6 py-8 md:px-10 md:py-12">
    <div class="divide-y divide-neutral-300/90 border-y border-neutral-300/90">
      {{ dimensions_item }}
      {{ features_item }}
    </div>
  </div>
{% endif %}

