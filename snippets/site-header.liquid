{% liquid
  assign main_menu = linklists['main-menu']
  assign nav_items = shop.metaobjects.navigation_item.values
%}
<div class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-[120px] bg-gradient-to-b from-black/45 to-transparent" aria-hidden="true"></div>

  <header id="site-header" class="fixed top-0 left-0 right-0 z-[100] flex h-[88px] items-center justify-between px-10" style="--header-pad-x: 40px;" role="banner">
    <button type="button" id="btn-menu" class="flex items-center gap-3 text-base font-semibold tracking-wide text-white hover:opacity-80 transition-opacity" aria-expanded="false" aria-controls="mega-menu" aria-haspopup="dialog" aria-label="{{ 'header.menu_open' | t }}">
      <img src="{{ 'icons/menu.svg' | asset_url }}" width="32" height="32" alt="" class="shrink-0" aria-hidden="true">
      <span aria-hidden="true">{{ 'header.menu_visible' | t }}</span>
    </button>
    <a href="{{ routes.root_url }}" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-label="{{ 'header.home' | t: shop_name: shop.name }}">
      <img src="{{ 'icons/prava_logo.svg' | asset_url }}" width="120" height="22" alt="{{ shop.name | escape }}" class="h-[22px] w-auto">
    </a>
    <nav class="flex items-center gap-8 lg:gap-10 text-[15px] font-semibold tracking-wide text-white" aria-label="{{ 'header.utility_nav' | t }}">
      <a href="{{ routes.search_url }}" class="hidden sm:flex items-center gap-2 hover:opacity-80 transition-opacity font-light border-b border-white/40 py-1" aria-label="{{ 'header.search' | t }}">
        <img src="{{ 'icons/search.svg' | asset_url }}" width="18" height="17" alt="" aria-hidden="true">
        <span>{{ 'header.search' | t }}</span>
      </a>
      <a href="{{ routes.account_url }}" class="hidden md:inline hover:opacity-80 transition-opacity font-light">{{ 'header.account' | t }}</a>
      <a href="{{ routes.cart_url }}" class="flex items-center gap-2 hover:opacity-80 transition-opacity font-light" aria-label="{{ 'header.cart' | t }}">
        <span>{{ 'header.cart' | t }}</span>
        <img src="{{ 'icons/basket.svg' | asset_url }}" width="32" height="32" alt="" aria-hidden="true">
      </a>
    </nav>
  </header>

  <div id="mega-menu" class="mega-menu" role="dialog" aria-modal="true" aria-label="{{ 'header.mega_menu_label' | t }}" hidden>
    <div class="mega-menu__inner" style="--mega-pad-x: 40px;">
      <div class="mega-menu__bar">
        <button type="button" class="mega-menu__close pl-2" id="mega-menu-close" aria-label="{{ 'header.mega_menu_close' | t }}">
          <svg class="mega-menu__close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
          <span class="text-base font-semibold" aria-hidden="true">{{ 'header.close_visible' | t }}</span>
        </button>
        <div class="mega-menu__logo" id="mega-menu-logo">
          <img src="{{ 'icons/prava_logo.svg' | asset_url }}" width="120" height="22" alt="{{ shop.name | escape }}" class="h-[22px] w-auto invert">
        </div>
      </div>
      {% comment %} main-menu (Gezinme) + navigation_item metaobject — snippets/mega-menu-dynamic.liquid {% endcomment %}
      {% render 'mega-menu-dynamic', main_menu: main_menu, nav_items: nav_items %}
      {% if main_menu.links.size > 0 %}
        <div class="mega-menu__footer">
          <a href="{{ main_menu.links.first.url }}" class="mega-menu__footer-link" id="mega-footer-discover">{{ main_menu.links.first.title | escape }}</a>
          <a href="#" class="mega-menu__footer-cta" id="mega-footer-cta">{{ 'header.mega_default_cta' | t }}</a>
        </div>
      {% endif %}
    </div>
  </div>
