{% comment %}
  product-color-variants — PDP’de renk alternatifleri (metaobject listesi: custom.color_variants).
  Her öğe: label, swatch_color | swatch_image, product_referance → ayrı ürün URL’si.
  Kullanım: {% render 'product-color-variants', product: product, section_id: section.id %}
{% endcomment %}
{% assign color_variants = product.metafields.custom.color_variants.value %}
{% assign cv_sid = section_id | default: 'pdp' %}

{% if color_variants != blank %}
  {% assign active_color_label = '' %}
  {% for variant in color_variants %}
    {% assign ref_product = variant.product_reference.value %}
    {% if ref_product != blank and ref_product.id == product.id %}
      {% assign active_color_label = variant.label.value %}
      {% break %}
    {% endif %}
  {% endfor %}

  <div class="color-variants mt-4 flex flex-col gap-2">
    <div class="flex items-center gap-2 text-sm font-medium text-neutral-800" id="ColorVariantsLegend-{{ cv_sid }}">
      <span>{{ 'general.accessibility.color_options' | t }}:</span>
      {% if active_color_label != blank %}
        <span class="font-normal text-neutral-600">{{ active_color_label | escape }}</span>
      {% endif %}
    </div>
    <div
      class="flex items-center gap-3"
      role="group"
      aria-labelledby="ColorVariantsLegend-{{ cv_sid }}"
    >
      {% for variant in color_variants %}
        {% assign label = variant.label.value %}
        {% assign swatch_color = variant.swatch_color.value %}
        {% assign swatch_image = variant.swatch_image.value %}
        {% assign ref_product = variant.product_reference.value %}
        {% assign is_active = false %}
        {% if ref_product != blank and ref_product.id == product.id %}
          {% assign is_active = true %}
        {% endif %}

        {% if ref_product != blank %}
          <a
            href="{{ ref_product.url }}"
            class="color-swatch group relative inline-flex items-center justify-center rounded-full transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-800 {% unless is_active %}hover:bg-neutral-100{% endunless %}"
            data-title="{{ label | escape }}"
            aria-label="{{ label | escape }}"
            {% if is_active %}
              aria-current="true"
            {% endif %}
          >
            {% if swatch_image != blank %}
              {% if is_active %}
                <span class="rounded-full border border-neutral-900 bg-white p-[2px] transition duration-200 ease-out group-hover:scale-110 group-focus-visible:scale-110">
                  <span class="relative block h-5 w-5 shrink-0 overflow-hidden rounded-full bg-white">
                    <img
                      src="{{ swatch_image | image_url: width: 40 }}"
                      alt=""
                      width="20"
                      height="20"
                      class="h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    >
                  </span>
                </span>
              {% else %}
                <span class="relative block h-5 w-5 shrink-0 overflow-hidden rounded-full bg-white transition duration-200 ease-out group-hover:scale-110 group-hover:shadow-sm group-focus-visible:scale-110 group-focus-visible:shadow-sm">
                  <img
                    src="{{ swatch_image | image_url: width: 40 }}"
                    alt=""
                    width="20"
                    height="20"
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  >
                </span>
              {% endif %}
            {% elsif swatch_color != blank %}
              {% if is_active %}
                <span class="rounded-full border border-neutral-900 bg-white p-[2px] transition duration-200 ease-out group-hover:scale-110 group-focus-visible:scale-110">
                  <span
                    class="swatch__dot relative block h-5 w-5 shrink-0 rounded-full"
                    style="background-color: {{ swatch_color }};"
                  ></span>
                </span>
              {% else %}
                <span
                  class="swatch__dot relative block h-5 w-5 shrink-0 rounded-full transition duration-200 ease-out group-hover:scale-110 group-hover:shadow-sm group-focus-visible:scale-110 group-focus-visible:shadow-sm"
                  style="background-color: {{ swatch_color }};"
                ></span>
              {% endif %}
            {% endif %}
            {% if label != blank %}
              <span class="pointer-events-none absolute left-1/2 top-full z-20 mt-2 hidden -translate-x-1/2 whitespace-nowrap rounded bg-neutral-900 px-2 py-1 text-[11px] font-medium text-white shadow-sm group-hover:block group-focus-visible:block">
                {{ label | escape }}
              </span>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}
