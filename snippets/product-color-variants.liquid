{% comment %}
  product-color-variants — PDP’de renk alternatifleri (metaobject listesi: custom.color_variants).
  Her öğe: label, swatch_color | swatch_image, product_referance → ayrı ürün URL’si.
  Kullanım: {% render 'product-color-variants', product: product, section_id: section.id %}
{% endcomment %}
{% assign color_variants = product.metafields.custom.color_variants.value %}
{% assign _cv_sid = section_id | default: 'pdp' %}

{% if color_variants != blank %}
  <div class="color-variants mt-4 flex flex-col gap-2">
    <span class="text-sm font-medium text-neutral-800" id="ColorVariantsLegend-{{ _cv_sid }}">
      {{- 'general.accessibility.color_options' | t -}}
    </span>
    <div
      class="flex flex-wrap gap-2"
      role="group"
      aria-labelledby="ColorVariantsLegend-{{ _cv_sid }}"
    >
      {% for variant in color_variants %}
        {% assign label = variant.label.value %}
        {% assign swatch_color = variant.swatch_color.value %}
        {% assign swatch_image = variant.swatch_image.value %}
        {% assign ref_product = variant.product_reference.value %}

        {% if ref_product != blank %}
          <a
            href="{{ ref_product.url }}"
            class="color-swatch group inline-flex max-w-[140px] flex-col items-center gap-1.5 rounded-lg border border-transparent p-1 text-center text-xs text-neutral-800 transition-colors hover:border-neutral-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-800 {% if ref_product.id == product.id %}is-active border-neutral-900 ring-2 ring-neutral-400{% endif %}"
            title="{{ label | escape }}"
            {% if ref_product.id == product.id %}
              aria-current="true"
            {% endif %}
          >
            {% if swatch_image != blank %}
              <span
                class="relative block h-10 w-10 shrink-0 overflow-hidden rounded-full border border-neutral-200 bg-white"
              >
                <img
                  src="{{ swatch_image | image_url: width: 80 }}"
                  alt=""
                  width="40"
                  height="40"
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                >
              </span>
            {% elsif swatch_color != blank %}
              <span
                class="swatch__dot relative block h-10 w-10 shrink-0 rounded-full border border-neutral-200"
                style="background-color: {{ swatch_color }};"
              ></span>
            {% endif %}

            {% if label != blank %}
              <span class="swatch__label line-clamp-2 leading-tight">{{ label | escape }}</span>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}
