{% capture seo_title %}
{{- page_title -}}
{%- if current_tags -%}
  – {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}
{%- endif -%}
{%- if current_page != 1 -%}
  – {{ 'general.meta.page' | t: page: current_page }}
{%- endif -%}
{%- unless page_title contains shop.name -%}
  – {{ shop.name }}
{%- endunless -%}
{% endcapture %}
{% assign seo_title = seo_title | strip %}

{% assign seo_desc = page_description | default: shop.description %}
{% assign seo_desc = seo_desc | strip_html | strip | truncate: 160, '' %}

{% liquid
  assign og_type = 'website'
  if template.name == 'product'
    assign og_type = 'product'
  elsif template.name == 'article'
    assign og_type = 'article'
  endif

  assign og_image_url = nil
  if template.name == 'product' and product != blank and product.featured_image != blank
    assign og_image_url = product.featured_image | image_url: width: 1200
  elsif settings.seo_share_image != blank
    assign og_image_url = settings.seo_share_image | image_url: width: 1200
  elsif settings.mega_menu_featured_image != blank
    assign og_image_url = settings.mega_menu_featured_image | image_url: width: 1200
  endif

  if og_image_url and og_image_url contains 'http'
    assign og_image_abs = og_image_url
  elsif og_image_url
    assign og_image_abs = og_image_url | prepend: 'https:'
  else
    assign og_image_abs = nil
  endif

  assign og_locale = request.locale.iso_code | replace: '-', '_'
%}
{% if seo_desc != blank %}
  <meta property="og:description" content="{{ seo_desc | escape }}">
  <meta name="twitter:description" content="{{ seo_desc | escape }}">
{% endif %}
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:locale" content="{{ og_locale | escape }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
{% if og_image_abs %}
  <meta property="og:image" content="{{ og_image_abs | escape }}">
  <meta property="og:image:width" content="1200">
  <meta name="twitter:image" content="{{ og_image_abs | escape }}">
{% endif %}
