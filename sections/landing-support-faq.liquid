<section class="prava-support-faq bg-custom-color text-neutral-900 px-0 lg:px-10 pt-16 lg:pt-24 pb-10 lg:pb-24" aria-label="{{ 'sections.faq.aria_label' | t }}">
  <div class="relative mx-auto overflow-hidden bg-product-color px-5 lg:px-10 py-5 lg:py-10 max-w-[1200px]">
    {% if section.settings.support_texture_image != blank %}
      <div class="pointer-events-none absolute inset-0 bg-no-repeat bg-[position:top_right] lg:bg-[position:200px_center] bg-[length:230px_auto] opacity-20" style="background-image: url('{{ section.settings.support_texture_image | image_url: width: 800 }}');" aria-hidden="true"></div>
    {% endif %}
    <div class="relative z-10 flex flex-col gap-12 lg:flex-row lg:items-center">
      <div class="prava-support-faq__intro relative z-[1] w-full shrink-0 lg:max-w-[min(100%,420px)] xl:max-w-[480px]">
        <div class="pointer-events-none absolute -right-8 bottom-0 left-0 top-0 overflow-visible opacity-[0.12] lg:-right-4" aria-hidden="true"></div>
        {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
          <h2 id="faq-support-heading" class="relative font-semibold text-neutral-800 text-4xl lg:text-[50px] leading-none text-center lg:text-left">
            {% if section.settings.heading_line_1 != blank %}
              <span class="inline-block lg:block">{{ section.settings.heading_line_1 | escape }}</span>
            {% endif %}
            {% if section.settings.heading_line_2 != blank %}
              <span class="mt-1 inline-block lg:block md:mt-2">{{ section.settings.heading_line_2 | escape }}</span>
            {% endif %}
          </h2>
        {% endif %}
      </div>
      <div
        class="prava-support-faq__list min-w-0 flex-1 [&>details:last-child]:border-b-0"
        role="region"
        {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
          aria-labelledby="faq-support-heading"
        {% else %}
          aria-label="{{ 'sections.faq.list_label' | t }}"
        {% endif %}
      >
        <p class="sr-only">{{ 'sections.faq.list_label' | t }}</p>
        {% for block in section.blocks %}
          {% if block.settings.question != blank %}
            <details class="prava-support-faq__item border-b border-[#d9d3c8]" {{ block.shopify_attributes }}>
              <summary class="flex cursor-pointer list-none items-start gap-3 py-5 pr-2 text-left text-base font-normal text-neutral-800 outline-none transition-colors hover:text-neutral-900 focus-visible:ring-2 focus-visible:ring-neutral-800 focus-visible:ring-offset-2 md:gap-4 md:text-lg md:leading-snug">
                <span class="prava-support-faq__icon mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center text-lg font-light leading-none text-neutral-700 transition-transform duration-200 md:text-xl" aria-hidden="true">+</span>
                <span>{{ block.settings.question | escape }}</span>
              </summary>
              <div class="prava-support-faq__panel prava-support-faq__panel--inner">
                {% if block.settings.answer != blank %}
                  <div class="rte pb-5 pl-8 text-sm leading-relaxed text-neutral-600 md:pl-11 md:text-[15px]">
                    {{ block.settings.answer }}
                  </div>
                {% endif %}
              </div>
            </details>
          {% elsif request.design_mode %}
            <div class="border-b border-dashed border-neutral-300 py-6 text-sm text-neutral-500" {{ block.shopify_attributes }}>
              Soru ekleyin
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% liquid
  assign ld_first = true
%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        {%- unless ld_first -%},{%- endunless -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | strip | json }}
          }
        }
        {%- assign ld_first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Destek / SSS",
  "tag": "div",
  "class": "landing-support-faq-section",
  "max_blocks": 40,
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Başlık — 1. satır",
      "default": "Prava"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Başlık — 2. satır",
      "default": "Destek"
    },
    {
      "type": "image_picker",
      "id": "support_texture_image",
      "label": "Kutu arka plan dokusu"
    }
  ],
  "blocks": [
    {
      "type": "support-faq-row",
      "name": "Soru / cevap",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Soru"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Cevap"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Destek / SSS",
      "blocks": [
        {
          "type": "support-faq-row",
          "settings": {
            "question": "Prava'yı neden tercih etmelisiniz?",
            "answer": "<p>PRAVA, Avrupa standartlarında test edilen ürünler; ergonomik tasarım, güvenli malzemeler ve günlük kullanımda pratik detaylarla öne çıkar. Uzun ömürlü bileşenler ve şeffaf yedek parça desteği ile ailelerin yanında olmayı hedefler.</p>"
          }
        },
        {
          "type": "support-faq-row",
          "settings": {
            "question": "Bebeğim için en güvenli seçimi nasıl yapabilirim?",
            "answer": "<p>Ürün yaşı ve kilo aralığına uygunluk, emniyet kemeri / Isofix kullanımı ve üretici talimatlarına uyum önemlidir. Satın almadan önce mağazada deneme, kapsül–puset uyumluluğu ve fren / katlanma mekanizmasını kontrol etmenizi öneririz.</p>"
          }
        },
        {
          "type": "support-faq-row",
          "settings": {
            "question": "Hangi bebek arabası kullanımım için en pratik olanıdır?",
            "answer": "<p>Şehir içi ve toplu taşıma için hafif baston veya kompakt modeller; uzun yürüyüşler ve farklı arazi için süspansiyonlu ve daha geniş tekerlekli modeller uygundur. Travel sistem ihtiyacınız varsa ana kucağı + puset uyumunu birlikte değerlendirin.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
