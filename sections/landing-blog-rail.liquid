<section class="prava-blog-rail relative bg-[#F2F2F0] text-neutral-900 overflow-hidden" aria-label="{{ 'sections.blog.aria_label' | t }}" style="--pbr-pad-x: 40px;">
  <div class="mx-auto px-[var(--pbr-pad-x)] py-28 pr-0">
    {% if section.settings.blog_texture_image != blank %}
      <div class="pointer-events-none absolute inset-0 bg-no-repeat bg-[position:100px_bottom] bg-[length:800px_auto] opacity-10" style="background-image: url('{{ section.settings.blog_texture_image | image_url: width: 1600 }}');" aria-hidden="true"></div>
    {% endif %}
    {% liquid
      assign cta_href = section.settings.cta_url | strip
      if cta_href == blank and section.settings.cta_blog != blank
        assign cta_href = section.settings.cta_blog.url
      endif
      if cta_href == blank
        assign cta_href = '#'
      endif
      assign cta_visible = section.settings.cta_label | strip
      if cta_visible == blank
        assign cta_visible = 'sections.blog.cta_all_visible' | t
      endif
    %}
    <div class="flex flex-col gap-12 lg:flex-row lg:items-center lg:gap-14 xl:gap-20">
      <div class="prava-blog-rail__intro relative z-[1] w-full max-w-xl shrink-0 lg:max-w-[min(100%,400px)] xl:max-w-[640px] pl-[40px]">
        <div class="pointer-events-none absolute -left-4 -right-4 bottom-0 top-8 overflow-hidden opacity-[0.08] lg:left-0 lg:right-auto lg:w-[120%]" aria-hidden="true">
          {% if section.settings.blog_intro_decoration_image != blank %}
            <img
              src="{{ section.settings.blog_intro_decoration_image | image_url: width: 640 }}"
              alt=""
              class="h-auto w-full max-w-[320px] object-contain object-left-bottom"
              width="400"
              height="300"
              loading="lazy"
            >
          {% endif %}
        </div>
        {% if section.settings.heading != blank %}
          <h2 class="relative font-semibold leading-none text-neutral-900 lg:text-[80px]">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="relative mt-5 text-base font-normal leading-relaxed text-neutral-600 md:text-lg rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
        <a
          href="{{ cta_href }}"
          class="relative mt-8 inline-flex items-center gap-2 text-base font-light text-neutral-900 underline decoration-neutral-900 underline-offset-[5px] transition-opacity hover:opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
          aria-label="{{ 'sections.blog.cta_all' | t }}"
        >
          {{ cta_visible }}
          <span aria-hidden="true" class="text-lg leading-none">→</span>
        </a>
      </div>
      <div class="prava-blog-rail__viewport min-w-0 flex-1 lg:min-h-[min(420px,50vh)] overflow-hidden">
        <div class="swiper prava-blog-rail__swiper w-full overflow-visible">
          <div class="swiper-wrapper">
            {% assign first_blog_slide = 'yes' %}
            {% for block in section.blocks %}
              {% if block.settings.article != blank or request.design_mode %}
                {% liquid
                  if first_blog_slide == 'yes'
                    assign card_loading = 'eager'
                    assign first_blog_slide = 'no'
                  else
                    assign card_loading = 'lazy'
                  endif
                %}
                <div class="swiper-slide !h-auto">
                  {% render 'blog-article-card',
                    article: block.settings.article,
                    block: block,
                    title_id: 'blog-teaser-title-' | append: block.id,
                    image_loading: card_loading
                  %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog şeridi",
  "tag": "div",
  "class": "landing-blog-rail-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Mutlu Yolculuklar Blogu"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Açıklama",
      "default": "<p>Bebek arabaları, güvenlik ve konfor hakkında güncel yazılar; yolculuklarınızı daha keyifli hale getirecek ipuçları burada.</p>"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "«Tüm yazılar» bağlantısı",
      "info": "Boş bırakılırsa aşağıdaki blog sayfası kullanılır."
    },
    {
      "type": "blog",
      "id": "cta_blog",
      "label": "«Tüm yazılar» — varsayılan blog",
      "info": "URL boşsa bu blogun liste sayfasına gidilir."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "«Tüm yazılar» metni",
      "info": "Boş bırakılırsa tema çevirisi kullanılır."
    },
    {
      "type": "image_picker",
      "id": "blog_texture_image",
      "label": "Arka plan dokusu (hafif)"
    },
    {
      "type": "image_picker",
      "id": "blog_intro_decoration_image",
      "label": "Giriş sütunu — dekor görseli",
      "info": "İsteğe bağlı."
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Blog yazısı",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Yazı"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog şeridi",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
