<section class="prava-blog-rail bg-[#F2F2F0] text-neutral-900 overflow-hidden" aria-label="Blog" style="--pbr-pad-x: 40px;">
  <div class="mx-auto px-[var(--pbr-pad-x)] py-28 pr-0">
    {% if section.settings.blog_texture_image != blank %}
      <div class="pointer-events-none absolute inset-0 bg-no-repeat bg-[position:100px_bottom] bg-[length:800px_auto] opacity-10" style="background-image: url('{{ section.settings.blog_texture_image | image_url: width: 1600 }}');" aria-hidden="true"></div>
    {% endif %}
    <div class="flex flex-col gap-12 lg:flex-row lg:items-center lg:gap-14 xl:gap-20">
      <div class="prava-blog-rail__intro relative z-[1] w-full max-w-xl shrink-0 lg:max-w-[min(100%,400px)] xl:max-w-[640px] pl-[40px]">
        <div class="pointer-events-none absolute -left-4 -right-4 bottom-0 top-8 overflow-hidden opacity-[0.08] lg:left-0 lg:right-auto lg:w-[120%]" aria-hidden="true">
          {% if section.settings.blog_intro_decoration_image != blank %}
            <img
              src="{{ section.settings.blog_intro_decoration_image | image_url: width: 640 }}"
              alt=""
              class="h-auto w-full max-w-[320px] object-contain object-left-bottom"
              width="400"
              height="300"
              loading="lazy"
            >
          {% endif %}
        </div>
        <h2 class="relative font-semibold leading-none text-neutral-900 lg:text-[80px]">
          Mutlu Yolculuklar Blogu
        </h2>
        <p class="relative mt-5 text-base font-normal leading-relaxed text-neutral-600 md:text-lg">
          Bebek arabaları, güvenlik ve konfor hakkında güncel yazılar; yolculuklarınızı daha keyifli hale getirecek ipuçları burada.
        </p>
        <a href="#" class="relative mt-8 inline-flex items-center gap-2 text-base font-light text-neutral-900 underline decoration-neutral-900 underline-offset-[5px] transition-opacity hover:opacity-70">
          Tüm Blog Yazıları
          <span aria-hidden="true" class="text-lg leading-none">→</span>
        </a>
      </div>
      <div class="prava-blog-rail__viewport min-w-0 flex-1 lg:min-h-[min(420px,50vh)] overflow-hidden">
        <div class="swiper prava-blog-rail__swiper w-full overflow-visible">
          <div class="swiper-wrapper">
            <div class="swiper-slide !h-auto">
              <a href="#" class="prava-blog-card group flex h-full flex-col overflow-hidden rounded-sm bg-white shadow-sm ring-1 ring-black/[0.04] transition-shadow hover:shadow-md">
                <div class="aspect-[1/1] w-full overflow-hidden bg-neutral-100">
                  {% if section.settings.blog_card_1_image != blank %}
                    <img
                      src="{{ section.settings.blog_card_1_image | image_url: width: 900 }}"
                      alt=""
                      class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
                      width="640"
                      height="400"
                      loading="lazy"
                      decoding="async"
                    >
                  {% endif %}
                </div>
                <div class="flex flex-1 flex-col p-6 md:p-8">
                  <h3 class="text-lg font-medium leading-snug tracking-tight text-neutral-900 md:text-xl">
                    Bebek arabası seçerken nelere dikkat etmeliyim?
                  </h3>
                  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-neutral-600 md:text-[15px]">
                    Güvenlik kemeri, fren sistemi ve katlanma mekanizması gibi kritik noktaları özetleyen pratik bir rehber. Aileniz için doğru modeli seçmenize yardımcı olacak ipuçları…
                  </p>
                </div>
              </a>
            </div>
            <div class="swiper-slide !h-auto">
              <a href="#" class="prava-blog-card group flex h-full flex-col overflow-hidden rounded-sm bg-white shadow-sm ring-1 ring-black/[0.04] transition-shadow hover:shadow-md">
                <div class="aspect-[1/1] w-full overflow-hidden bg-neutral-100">
                  {% if section.settings.blog_card_2_image != blank %}
                    <img
                      src="{{ section.settings.blog_card_2_image | image_url: width: 900 }}"
                      alt=""
                      class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
                      width="640"
                      height="400"
                      loading="lazy"
                      decoding="async"
                    >
                  {% endif %}
                </div>
                <div class="flex flex-1 flex-col p-6 md:p-8">
                  <h3 class="text-lg font-medium leading-snug tracking-tight text-neutral-900 md:text-xl">
                    Travel sistem ile şehir içi kullanım
                  </h3>
                  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-neutral-600 md:text-[15px]">
                    Ana kucağı ve puset uyumunu bir arada düşünerek günlük rutininizi nasıl kolaylaştırabileceğinizi anlatıyoruz. Kompakt katlanma ve taşıma önerileri…
                  </p>
                </div>
              </a>
            </div>
            <div class="swiper-slide !h-auto">
              <a href="#" class="prava-blog-card group flex h-full flex-col overflow-hidden rounded-sm bg-white shadow-sm ring-1 ring-black/[0.04] transition-shadow hover:shadow-md">
                <div class="aspect-[1/1] w-full overflow-hidden bg-neutral-100">
                  {% if section.settings.blog_card_3_image != blank %}
                    <img
                      src="{{ section.settings.blog_card_3_image | image_url: width: 900 }}"
                      alt=""
                      class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
                      width="640"
                      height="400"
                      loading="lazy"
                      decoding="async"
                    >
                  {% endif %}
                </div>
                <div class="flex flex-1 flex-col p-6 md:p-8">
                  <h3 class="text-lg font-medium leading-snug tracking-tight text-neutral-900 md:text-xl">
                    Yenidoğan için kapsül ve adaptör seçimi
                  </h3>
                  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-neutral-600 md:text-[15px]">
                    İlk aylarda taşıma konforu ve araç güvenliği için dikkat edilmesi gerekenler. Isofix, emniyet kemeri yönlendirmesi ve uyumlu aksesuarlar…
                  </p>
                </div>
              </a>
            </div>
            <div class="swiper-slide !h-auto">
              <a href="#" class="prava-blog-card group flex h-full flex-col overflow-hidden rounded-sm bg-white shadow-sm ring-1 ring-black/[0.04] transition-shadow hover:shadow-md">
                <div class="aspect-[1/1] w-full overflow-hidden bg-neutral-100">
                  {% if section.settings.blog_card_4_image != blank %}
                    <img
                      src="{{ section.settings.blog_card_4_image | image_url: width: 900 }}"
                      alt=""
                      class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
                      width="640"
                      height="400"
                      loading="lazy"
                      decoding="async"
                    >
                  {% endif %}
                </div>
                <div class="flex flex-1 flex-col p-6 md:p-8">
                  <h3 class="text-lg font-medium leading-snug tracking-tight text-neutral-900 md:text-xl">
                    Mevsim geçişlerinde bebek arabası bakımı
                  </h3>
                  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-neutral-600 md:text-[15px]">
                    Tekerlek temizliği, yağmurluk kullanımı ve depolama önerileriyle ürününüzün ömrünü uzatın. Basit adımlarla hijyen ve performans…
                  </p>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog şeridi",
  "tag": "div",
  "class": "landing-blog-rail-section",
  "settings": [
    {
      "type": "header",
      "content": "Blog şeridi"
    },
    {
      "type": "image_picker",
      "id": "blog_texture_image",
      "label": "Arka plan dokusu (hafif)"
    },
    {
      "type": "image_picker",
      "id": "blog_intro_decoration_image",
      "label": "Giriş sütunu — dekor görseli",
      "info": "Intro bölümünden bağımsız; isteğe bağlı aynı görsel yüklenebilir."
    },
    {
      "type": "image_picker",
      "id": "blog_card_1_image",
      "label": "Blog kartı 1"
    },
    {
      "type": "image_picker",
      "id": "blog_card_2_image",
      "label": "Blog kartı 2"
    },
    {
      "type": "image_picker",
      "id": "blog_card_3_image",
      "label": "Blog kartı 3"
    },
    {
      "type": "image_picker",
      "id": "blog_card_4_image",
      "label": "Blog kartı 4"
    }
  ],
  "presets": [{ "name": "Blog şeridi" }]
}
{% endschema %}
