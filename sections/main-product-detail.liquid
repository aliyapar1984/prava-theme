{% comment %}
  main-product-detail — Shopify ürün detay (PDP) ana bölümü.

  Ne işe yarar?
  - Sol: medya galerisi (tek Swiper DOM; mobil swipe, md+ CSS grid).
  - Sağ: başlık (tek h1), açıklama, taksit metni (Shopify payment_terms), sepete ekle formu, fiyat.
  - Renk grupları ayrı ürün URL’leri (metafield: snippets/product-color-variants); sayfada tek Shopify varyantı (gizli id).
  - Aşağıda tema editörü blokları: özellik kutuları, teknik akordeon, 360/3D veya yer tutucu, benzer ürünler (her biri ayrı ATC formu), destek SSS.

  JS (assets/product-detail.js): Ajax sepete ekleme; [data-prava-pdp] + ProductForm-{section.id}.
{% endcomment %}
{% liquid
  assign current_variant = product.selected_or_first_available_variant

  # Medyada 3D model — model_viewer_tag + CDN stylesheet
  assign first_model = null
  for m in product.media
    if m.media_type == 'model'
      assign first_model = m
      break
    endif
  endfor

  # Breadcrumb: üst link için ürünün ilk koleksiyonu
  assign parent_col = product.collections.first

  # Sepet formu id + taksit formu id (aynı sayfada iki form; id’ler benzersiz)
  assign product_form_id = 'ProductForm-' | append: section.id
  assign installment_form_id = 'ProductInstallment-' | append: section.id
%}

{%- comment -%}
  3D model varsa: model_viewer bileşeninin stilleri (Shopify CDN). media="print" + onload ile render bloklamadan yükleme.
{%- endcomment -%}
{%- if first_model -%}
  <link
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

{% comment %} Ajax sepete ekleme (product-detail.js) {% endcomment %}
<script src="{{ 'product-detail.js' | asset_url }}" defer="defer"></script>

<section
  class="prava-pdp bg-[#f5f5f3] text-neutral-900"
  data-prava-pdp
  data-section-id="{{ section.id }}"
  aria-label="{{ 'sections.product_detail.aria_label' | t }}"
>
  <div class="mx-auto max-w-[1680px] px-10 pb-16 pt-8 md:pb-24 md:pt-12">
    {% if parent_col != blank %}
      {% render 'breadcrumbs',
        current_title: product.title,
        parent_title: parent_col.title,
        parent_url: parent_col.url
      %}
    {% else %}
      {% render 'breadcrumbs', current_title: product.title %}
    {% endif %}

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-14 xl:gap-20">
      {% comment %}
        Sol sütun — Tek Swiper iskeleti: mobilde swipe (slidesPerView auto, boyutlar CSS);
        md+ breakpoint’te JS devre dışı, wrapper CSS grid (1 + 2 sütun).
      {% endcomment %}
      <div
        class="prava-pdp__gallery min-w-0 lg:sticky lg:top-24 lg:z-[1] lg:self-start"
        data-prava-pdp-gallery
      >
        {% if product.media.size == 0 %}
          <div class="overflow-hidden rounded-lg bg-white">
            <div class="flex aspect-square items-center justify-center bg-neutral-100 text-neutral-500">
              {{ 'products.no_image' | t }}
            </div>
          </div>
        {% else %}
          <div
            class="swiper prava-pdp__gallery-swiper w-full overflow-hidden rounded-lg md:overflow-visible"
            id="PdpGallerySwiper-{{ section.id }}"
            data-prava-pdp-gallery-swiper
            role="region"
            aria-label="{{ 'products.gallery_thumbnails' | t }}"
          >
            <div class="swiper-wrapper prava-pdp__gallery-wrapper">
              {% for media in product.media %}
                {% liquid
                  if forloop.first
                    assign media_loading = 'eager'
                  else
                    assign media_loading = 'lazy'
                  endif
                %}
                <div
                  class="swiper-slide prava-pdp__gallery-slide !h-auto"
                  data-media-id="{{ media.id }}"
                >
                  <div
                    class="overflow-hidden rounded-lg bg-white"
                    data-prava-pdp-media
                    data-media-id="{{ media.id }}"
                  >
                    {% render 'pdp-gallery-media', media: media, product: product, loading: media_loading %}
                  </div>
                </div>
              {% endfor %}
            </div>
            <div
              class="prava-pdp__gallery-pagination swiper-pagination !relative !mt-3 md:!hidden"
            ></div>
          </div>
        {% endif %}
      </div>

      {% comment %}
        Sağ sütun — Başlık (SEO: sayfada tek h1), isteğe bağlı satıcı, ürün açıklaması (RTE),
        ayrı taksit formu, ana sepet formu (gizli varyant id + miktar + fiyat + ATC).
      {% endcomment %}
      <div class="prava-pdp__info flex min-w-0 flex-col lg:sticky lg:top-24 lg:self-start">
        <header class="border-b border-neutral-200/80 pb-6">
          <h1 class="text-3xl font-medium tracking-tight text-neutral-900 md:text-[34px] md:leading-tight">
            {{ product.title | escape }}
          </h1>
          {% if section.settings.show_vendor and product.vendor != blank %}
            <p class="mt-2 text-sm font-light text-neutral-600">{{ product.vendor | escape }}</p>
          {% endif %}
        </header>

        {% if product.description != blank %}
          <div class="product-description rte mt-6 text-base leading-relaxed text-neutral-700">
            {{ product.description }}
          </div>
        {% endif %}

        {% render 'pdp-eligibility', product: product %}

        {% comment %}
          Taksit / ödeme koşulları: Shopify payment_terms için ürün formu ayrı bir form etiketi olarak tanımlanmalıdır.
          Gizli id tek satılabilir varyantı taşır (sayfada varyant seçici yok).
        {% endcomment %}
        <div class="mt-6">
          {% assign installment_variant_id = 'installment-variant-' | append: section.id %}
          {% form 'product', product, id: installment_form_id, class: 'installment-form text-sm text-neutral-600' %}
            <input type="hidden" name="id" id="{{ installment_variant_id }}" value="{{ current_variant.id }}">
            {{ form | payment_terms }}
          {% endform %}
        </div>

        {% comment %}
          Ana sepet formu: tek varyant (gizli id), gönder düğmesi name="add".
          Renk alternatifleri: snippets/product-color-variants (metafield custom.color_variants).
        {% endcomment %}
        {% form 'product', product, id: product_form_id, class: 'mt-8 flex flex-col gap-6' %}
          {% if form.errors %}
            <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert" tabindex="-1">
              <ul class="m-0 list-disc pl-5">
                {% for field in form.errors %}
                  <li>{{ form.errors.messages[field] }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {% render 'product-color-variants', product: product, section_id: section.id %}

          <input type="hidden" name="quantity" value="1">

          <div id="PdpPrice-{{ section.id }}" class="price-display" role="status">
            <p class="m-0 text-3xl font-semibold tracking-tight text-neutral-900 md:text-4xl">
              {% if current_variant.compare_at_price > current_variant.price %}
                <span class="mr-2 text-xl font-light text-neutral-500 line-through">
                  {{- current_variant.compare_at_price | money -}}
                </span>
              {% endif %}
              <span>{{ current_variant.price | money }}</span>
            </p>
          </div>

          <button
            type="submit"
            name="add"
            id="PdpSubmit-{{ section.id }}"
            class="w-full max-w-md border-0 bg-neutral-800 py-4 text-center text-base font-semibold uppercase tracking-widest text-white transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 disabled:cursor-not-allowed disabled:opacity-50"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {% if current_variant.available %}
              {{ 'products.add_to_cart' | t }}
            {% else %}
              {{ 'products.sold_out' | t }}
            {% endif %}
          </button>
        {% endform %}

        {% comment %} Tema ayarlarından gelen kısa güven metinleri (kargo / iade / güvenli ödeme). {% endcomment %}
        <ul class="mt-8 flex flex-wrap gap-6 text-sm text-neutral-600" role="list">
          {% if section.settings.trust_shipping != blank %}
            <li class="flex max-w-[200px] items-start gap-2">
              <span class="mt-0.5 shrink-0 text-neutral-800" aria-hidden="true">✓</span>
              <span>{{ section.settings.trust_shipping | escape }}</span>
            </li>
          {% endif %}
          {% if section.settings.trust_return != blank %}
            <li class="flex max-w-[200px] items-start gap-2">
              <span class="mt-0.5 shrink-0 text-neutral-800" aria-hidden="true">✓</span>
              <span>{{ section.settings.trust_return | escape }}</span>
            </li>
          {% endif %}
          {% if section.settings.trust_secure != blank %}
            <li class="flex max-w-[200px] items-start gap-2">
              <span class="mt-0.5 shrink-0 text-neutral-800" aria-hidden="true">✓</span>
              <span>{{ section.settings.trust_secure | escape }}</span>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>

    {% comment %}
      "Ürün detayı" alanı: ayarlardan başlık + giriş metni; blok tipi feature_tile = görsel + başlık + kısa metin (4 sütuna kadar grid).
    {% endcomment %}
    {% if section.settings.details_heading != blank
      or section.settings.details_intro != blank
      or section.blocks.size > 0
    %}
      <div class="mt-20 border-t border-neutral-200/90 pt-16">
        {% if section.settings.details_heading != blank %}
          <h2 class="text-3xl font-medium tracking-tight text-neutral-900 md:text-4xl">
            {{ section.settings.details_heading | escape }}
          </h2>
        {% endif %}
        {% if section.settings.details_intro != blank %}
          <div class="rte mt-4 max-w-3xl text-base leading-relaxed text-neutral-700">
            {{ section.settings.details_intro }}
          </div>
        {% endif %}
        <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {% for block in section.blocks %}
            {% if block.type == 'feature_tile' %}
              <article class="flex flex-col" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <div class="aspect-square overflow-hidden rounded-lg bg-white">
                    <img
                      src="{{ block.settings.image | image_url: width: 800 }}"
                      alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                      width="600"
                      height="600"
                      class="h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>
                {% endif %}
                {% if block.settings.heading != blank %}
                  <h3 class="mt-4 text-lg font-medium text-neutral-900">{{ block.settings.heading | escape }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="mt-2 text-sm leading-relaxed text-neutral-600">{{ block.settings.text | escape }}</p>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% comment %} Teknik özellikler: blok tipi spec_accordion — native <details>/<summary> (klavye ile erişilebilir). {% endcomment %}
    {% assign has_spec = false %}
    {% for block in section.blocks %}
      {% if block.type == 'spec_accordion' %}
        {% assign has_spec = true %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if has_spec %}
      <div class="mt-16 rounded-xl bg-[#ebe9e6] px-6 py-8 md:px-10 md:py-12">
        <h2 class="sr-only">{{ 'products.specs_heading' | t }}</h2>
        <div class="divide-y divide-neutral-300/90 border-y border-neutral-300/90">
          {% for block in section.blocks %}
            {% if block.type == 'spec_accordion' %}
              <details
                class="group py-2"
                {{ block.shopify_attributes }}
                {% if block.settings.open %}
                  open
                {% endif %}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-base font-medium text-neutral-900 outline-none marker:content-none [&::-webkit-details-marker]:hidden focus-visible:ring-2 focus-visible:ring-neutral-800 focus-visible:ring-offset-2">
                  <span>{{ block.settings.heading | escape }}</span>
                  <span
                    class="text-xl font-light text-neutral-600 transition-transform group-open:rotate-45"
                    aria-hidden="true"
                    >+</span
                  >
                </summary>
                <div class="rte pb-6 pr-8 text-sm leading-relaxed text-neutral-700 md:text-base">
                  {{ block.settings.body }}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% comment %}
      360° / 3D: ürün medyasında model varsa Shopify model_viewer_tag; yoksa ve ayar açıksa yer tutucu görsel + metin.
    {% endcomment %}
    {% if first_model != blank %}
      <div class="mt-20">
        <h2 class="text-center text-2xl font-medium text-neutral-900 md:text-3xl">{{ 'products.view_360' | t }}</h2>
        <div class="mx-auto mt-8 max-w-3xl [&_model-viewer]:aspect-square [&_model-viewer]:w-full [&_model-viewer]:bg-white">
          {{ first_model | model_viewer_tag: image_size: '1024x', reveal: 'interaction', toggleable: true }}
        </div>
        <p class="mt-4 text-center text-sm text-neutral-600">{{ 'products.view_360_help' | t }}</p>
      </div>
    {% elsif section.settings.show_360_placeholder %}
      <div class="mt-20 text-center">
        <h2 class="text-2xl font-medium text-neutral-900 md:text-3xl">{{ 'products.view_360' | t }}</h2>
        {% if section.settings.placeholder_360_image != blank %}
          <div class="mx-auto mt-8 max-w-2xl overflow-hidden rounded-xl bg-white">
            <img
              src="{{ section.settings.placeholder_360_image | image_url: width: 1200 }}"
              alt="{{ section.settings.placeholder_360_image.alt | default: product.title | escape }}"
              width="1200"
              height="800"
              class="w-full object-contain"
              loading="lazy"
            >
          </div>
        {% endif %}
        {% if section.settings.placeholder_360_text != blank %}
          <p class="mt-6 text-neutral-600">{{ section.settings.placeholder_360_text | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% render 'pdp-collection-recommendations', product: product, heading: section.settings.related_heading, limit: 8 %}

    {% render 'product-faq-items',
      product: product,
      heading: section.settings.support_heading,
      support_image: section.settings.support_image
    %}
  </div>

  {% render 'product-color-variants-json-ld', product: product %}
</section>

{% schema %}
{
  "name": "Ürün detay (ana)",
  "tag": "section",
  "class": "main-product-detail-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Satıcı adını göster",
      "default": false
    },
    {
      "type": "header",
      "content": "Ürün detayı bölümü"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Özellik alanı başlığı",
      "default": "Ürün Detayı"
    },
    {
      "type": "richtext",
      "id": "details_intro",
      "label": "Özellik alanı giriş metni"
    },
    {
      "type": "header",
      "content": "Güven metinleri (satır altı)"
    },
    {
      "type": "text",
      "id": "trust_shipping",
      "label": "Kargo",
      "default": "Ücretsiz kargo"
    },
    {
      "type": "text",
      "id": "trust_return",
      "label": "İade",
      "default": "Kolay iade"
    },
    {
      "type": "text",
      "id": "trust_secure",
      "label": "Güvenlik",
      "default": "Güvenli alışveriş"
    },
    {
      "type": "header",
      "content": "360° / 3D"
    },
    {
      "type": "checkbox",
      "id": "show_360_placeholder",
      "label": "3D yoksa yer tutucu göster",
      "default": true,
      "info": "Üründe 3D model yoksa açıklama ve isteğe bağlı görsel gösterilir."
    },
    {
      "type": "image_picker",
      "id": "placeholder_360_image",
      "label": "Yer tutucu görseli"
    },
    {
      "type": "text",
      "id": "placeholder_360_text",
      "label": "Yer tutucu metni",
      "default": "360° görünüm yakında veya mağazada deneyimleyin."
    },
    {
      "type": "header",
      "content": "Benzer ürünler"
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Başlık",
      "default": "Benzer Ürünler"
    },
    {
      "type": "url",
      "id": "related_cta_url",
      "label": "Tümünü gör — bağlantı"
    },
    {
      "type": "text",
      "id": "related_cta_label",
      "label": "Tümünü gör — metin",
      "default": "Tümünü Gör"
    },
    {
      "type": "header",
      "content": "Ürün destek"
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Başlık",
      "default": "Ürün Destek"
    },
    {
      "type": "image_picker",
      "id": "support_image",
      "label": "Başlık yanındaki görsel"
    }
  ],
  "blocks": [
    {
      "type": "feature_tile",
      "name": "Özellik kutusu",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Görsel"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Başlık",
          "default": "Özellik"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Metin",
          "default": "Kısa açıklama metni."
        }
      ]
    },
    {
      "type": "spec_accordion",
      "name": "Teknik satır (akordeon)",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Başlık",
          "default": "Boyutlar ve ağırlık"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "İçerik"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Varsayılan açık",
          "default": true
        }
      ]
    },
    {
      "type": "related_product",
      "name": "Benzer ürün",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Ürün"
        }
      ]
    },
  ],
  "presets": [
    {
      "name": "Ürün detay sayfası",
      "blocks": [
        {
          "type": "feature_tile",
          "settings": {
            "heading": "Premium kumaş",
            "text": "Nefes alabilen, kolay temizlenen döşeme."
          }
        },
        {
          "type": "feature_tile",
          "settings": {
            "heading": "Süspansiyon",
            "text": "Tüm tekerleklerde amortisör desteği."
          }
        },
        {
          "type": "spec_accordion",
          "settings": {
            "heading": "Boyutlar ve ağırlık",
            "open": true
          }
        },
        {
          "type": "spec_accordion",
          "settings": {
            "heading": "Özellikler",
            "open": false
          }
        },
        {
          "type": "spec_accordion",
          "settings": {
            "heading": "Kullanım talimatları",
            "open": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
