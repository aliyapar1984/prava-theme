<section class="bg-white text-neutral-900 relative z-10" aria-label="{{ 'sections.popular.aria_label' | t }}" style="--pcp-pad-x: 40px;">
  <div class="mx-auto max-w-[1600px] p-0">
    <div class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] lg:items-start">
      <article class="overflow-hidden bg-[#e7e4df]">
        <div
          class="parallax-item relative overflow-hidden aspect-[1/1]"
          data-start="-12"
          data-end="12"
          data-scrub="0.8"
        >
          <div class="parallax-content absolute inset-0">
            {% if section.settings.popular_feature_image != blank %}
              <img
                src="{{ section.settings.popular_feature_image | image_url: width: 1600 }}"
                alt="{{ 'sections.popular.feature_alt' | t }}"
                class="h-full w-full object-cover object-center"
                width="1200"
                height="700"
                loading="lazy"
                decoding="async"
              >
            {% endif %}
          </div>
          <div class="absolute left-0 top-0 z-10 bg-white px-8 py-6 md:px-12 md:py-8">
            <h2 class="font-medium leading-tight tracking-tight text-neutral-800 text-[40px]">
              Popüler Seçimler
            </h2>
          </div>
        </div>
      </article>

      <article class="left-[-40px] mt-10 relative z-10">
        <div class="aspect-[1/1] w-full bg-[#e7e4df]">
          {% if section.settings.popular_spotlight_image != blank %}
            <img
              src="{{ section.settings.popular_spotlight_image | image_url: width: 1040 }}"
              alt=""
              aria-labelledby="popular-spotlight-title"
              class="h-full w-full object-contain"
              width="520"
              height="640"
              loading="lazy"
              decoding="async"
            >
          {% endif %}
        </div>
        <div class="px-8 pb-8 pt-10 md:px-10 md:pb-10 ml-10">
          <h3 id="popular-spotlight-title" class="text-2xl font-normal leading-tight tracking-tight text-neutral-800">
            Gold Chrome Bebek Arabası
          </h3>
          <p class="mt-2 text-base font-light uppercase text-neutral-700">Puset</p>
          <div class="mt-8 flex items-center justify-between gap-6">
            <ul class="m-0 flex list-none items-center gap-3 p-0" role="list" aria-label="{{ 'general.accessibility.color_options' | t }}">
              <li class="m-0 p-0"><span class="inline-block h-5 w-5 rounded-full bg-[#bf7f83]" aria-hidden="true"></span></li>
              <li class="m-0 p-0"><span class="inline-block h-5 w-5 rounded-full bg-[#d4c176]" aria-hidden="true"></span></li>
              <li class="m-0 p-0"><span class="inline-block h-5 w-5 rounded-full bg-[#9ea78a]" aria-hidden="true"></span></li>
              <li class="m-0 p-0"><span class="inline-block h-5 w-5 rounded-full bg-[#88acc8]" aria-hidden="true"></span></li>
            </ul>
            <p class="text-right text-lg leading-none">
              <span class="mr-4 font-light text-neutral-500 line-through">16.000 TL</span>
              <span class="font-medium text-neutral-900">12.000 TL</span>
            </p>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Popüler — iki sütun",
  "tag": "div",
  "class": "landing-popular-split-section",
  "settings": [
    {
      "type": "header",
      "content": "Popüler blok"
    },
    {
      "type": "image_picker",
      "id": "popular_feature_image",
      "label": "Sol — büyük görsel"
    },
    {
      "type": "image_picker",
      "id": "popular_spotlight_image",
      "label": "Sağ — ürün görseli"
    }
  ],
  "presets": [{ "name": "Popüler — iki sütun" }]
}
{% endschema %}
