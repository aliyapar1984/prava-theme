<section id="hero" class="parallax-item fixed inset-x-0 top-0 z-[5] h-[100svh] min-h-0 w-full overflow-hidden"
      data-start="12"
      data-end="-12"
      data-scrub="0.8"
      aria-label="Ana vitrin">
  {% liquid
    assign hero_thumb_1 = section.settings.hero_slide_1_image
    if hero_thumb_1 == blank and section.settings.hero_video_poster_image != blank
      assign hero_thumb_1 = section.settings.hero_video_poster_image
    endif
  %}
  <div class="swiper hero-main h-full w-full parallax-content">
    <div class="swiper-wrapper">
      {% if section.settings.hero_video_url != blank %}
        <div class="swiper-slide relative h-full w-full overflow-hidden" {% if hero_thumb_1 != blank %}data-thumb="{{ hero_thumb_1 | image_url: width: 400 }}"{% endif %} data-hero-video="true">
          <div class="hero-parallax-layer absolute inset-0 overflow-hidden">
            <video
              class="hero-parallax-img hero-slide-video absolute left-1/2 top-1/2 h-[100%] w-[100%] max-w-none -translate-x-1/2 -translate-y-1/2 object-cover"
              {% if section.settings.hero_video_poster_image != blank %}poster="{{ section.settings.hero_video_poster_image | image_url: width: 1920 }}"{% endif %}
              preload="none"
              muted
              playsinline
              webkit-playsinline
              data-src="{{ section.settings.hero_video_url | escape }}"
              aria-label="Tanıtım videosu"
            ></video>
          </div>
          <div class="absolute inset-0 bg-black/15 z-[1] pointer-events-none"></div>
          <div class="hero-slide-content absolute inset-0 z-[2] flex items-center justify-start text-left">
            <div class="hero-slide-copy w-full max-w-[min(100%,560px)] px-10 pt-[88px] text-left ml-0 mr-auto will-change-transform">
              <h1 class="max-w-[16ch] text-left text-[clamp(2rem,4.2vw,3.5rem)] font-extrabold leading-[1.12] tracking-tight text-white">Rahatlıkla Büyüyen<br>Mutlu Adımlar.</h1>
              <p class="mt-10 max-w-[36ch] text-left text-lg font-normal leading-relaxed text-white/95">Her yolculukta, hem sizin hem bebeğinizin mutluluğu için tasarlandı.</p>
              <a href="#" class="mt-10 inline-block text-left text-lg font-bold uppercase text-white hover:opacity-80 transition-opacity">Keşfet</a>
            </div>
          </div>
        </div>
      {% else %}
        <div class="swiper-slide relative h-full w-full overflow-hidden" {% if section.settings.hero_slide_1_image != blank %}data-thumb="{{ section.settings.hero_slide_1_image | image_url: width: 400 }}"{% endif %}>
          <div class="hero-parallax-layer absolute inset-0 overflow-hidden">
            {% if section.settings.hero_slide_1_image != blank %}
              <img src="{{ section.settings.hero_slide_1_image | image_url: width: 1920 }}" alt="" class="hero-parallax-img absolute left-1/2 top-1/2 h-[100%] w-[100%] max-w-none -translate-x-1/2 -translate-y-1/2 object-cover" width="1920" height="1080" loading="eager">
            {% else %}
              <div class="hero-parallax-img absolute inset-0 bg-zinc-800" aria-hidden="true"></div>
            {% endif %}
          </div>
          <div class="absolute inset-0 bg-black/15 z-[1] pointer-events-none"></div>
          <div class="hero-slide-content absolute inset-0 z-[2] flex items-center justify-start text-left">
            <div class="hero-slide-copy w-full max-w-[min(100%,560px)] px-10 pt-[88px] text-left ml-0 mr-auto will-change-transform">
              <h1 class="max-w-[16ch] text-left text-[clamp(2rem,4.2vw,3.5rem)] font-extrabold leading-[1.12] tracking-tight text-white">Rahatlıkla Büyüyen<br>Mutlu Adımlar.</h1>
              <p class="mt-10 max-w-[36ch] text-left text-lg font-normal leading-relaxed text-white/95">Her yolculukta, hem sizin hem bebeğinizin mutluluğu için tasarlandı.</p>
              <a href="#" class="mt-10 inline-block text-left text-lg font-bold uppercase text-white hover:opacity-80 transition-opacity">Keşfet</a>
            </div>
          </div>
        </div>
      {% endif %}
      <div class="swiper-slide relative h-full w-full overflow-hidden" {% if section.settings.hero_slide_2_image != blank %}data-thumb="{{ section.settings.hero_slide_2_image | image_url: width: 400 }}"{% endif %}>
        <div class="hero-parallax-layer absolute inset-0 overflow-hidden">
          {% if section.settings.hero_slide_2_image != blank %}
            <img src="{{ section.settings.hero_slide_2_image | image_url: width: 1920 }}" alt="" class="hero-parallax-img absolute left-1/2 top-1/2 h-[100%] w-[100%] max-w-none -translate-x-1/2 -translate-y-1/2 object-cover" width="1920" height="1080" loading="lazy">
          {% else %}
            <div class="hero-parallax-img absolute inset-0 bg-zinc-800" aria-hidden="true"></div>
          {% endif %}
        </div>
        <div class="absolute inset-0 bg-black/15 z-[1] pointer-events-none"></div>
        <div class="hero-slide-content absolute inset-0 z-[2] flex items-center justify-start text-right">
          <div class="hero-slide-copy w-full max-w-[min(100%,560px)] px-10 pt-[88px] text-right ml-0 ml-auto will-change-transform">
            <h1 class="max-w-[16ch] text-right text-[clamp(2rem,4.2vw,3.5rem)] font-extrabold leading-[1.12] tracking-tight text-white">Yeni Sezon Geldi<br>%30’a Varan İndirimle</h1>
            <p class="mt-10 max-w-[36ch] text-right text-lg font-normal leading-relaxed text-white/95 ml-auto">En yeni bebek arabası modelleri şimdi avantajlı fiyatlarla. Konfor ve şıklığı birlikte keşfedin.</p>
            <a href="#" class="mt-10 inline-block text-right text-lg font-bold uppercase text-white hover:opacity-80 transition-opacity">Fırsatları Gör</a>
          </div>
        </div>
      </div>
      <div class="swiper-slide relative h-full w-full overflow-hidden" {% if section.settings.hero_slide_3_image != blank %}data-thumb="{{ section.settings.hero_slide_3_image | image_url: width: 400 }}"{% endif %}>
        <div class="hero-parallax-layer absolute inset-0 overflow-hidden">
          {% if section.settings.hero_slide_3_image != blank %}
            <img src="{{ section.settings.hero_slide_3_image | image_url: width: 1920 }}" alt="" class="hero-parallax-img absolute left-1/2 top-1/2 h-[100%] w-[100%] max-w-none -translate-x-1/2 -translate-y-1/2 object-cover" width="1920" height="1080" loading="lazy">
          {% else %}
            <div class="hero-parallax-img absolute inset-0 bg-zinc-800" aria-hidden="true"></div>
          {% endif %}
        </div>
        <div class="absolute inset-0 bg-black/15 z-[1] pointer-events-none"></div>
        <div class="hero-slide-content absolute inset-0 z-[2] flex items-center justify-start text-left">
          <div class="hero-slide-copy w-full max-w-[min(100%,560px)] px-10 pt-[88px] text-left ml-0 mr-auto will-change-transform">
            <h1 class="max-w-[16ch] text-left text-[clamp(2rem,4.2vw,3.5rem)] font-extrabold leading-[1.12] tracking-tight text-white">Güvenle Taşınan<br>Her An.</h1>
            <p class="mt-10 max-w-[36ch] text-left text-lg font-normal leading-relaxed text-white/95">Avrupa standartlarında test edilen travel sistem koleksiyonu.</p>
            <a href="#" class="mt-10 inline-block text-left text-lg font-bold uppercase text-white hover:opacity-80 transition-opacity">Keşfet</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="pointer-events-auto absolute bottom-[6vh] z-[90] flex items-center gap-3 md:gap-4" style="left: 40px;" id="hero-thumb-bar" role="tablist" aria-label="Slayt seçimi">
    <div class="swiper hero-thumbs sr-only" aria-hidden="true">
      <div class="swiper-wrapper">
        <div class="swiper-slide !w-auto"><button type="button" tabindex="-1" data-index="0">1</button></div>
        <div class="swiper-slide !w-auto"><button type="button" tabindex="-1" data-index="1">2</button></div>
        <div class="swiper-slide !w-auto"><button type="button" tabindex="-1" data-index="2">3</button></div>
      </div>
    </div>
    <div id="hero-pagination-custom" class="flex items-center gap-3 md:gap-4"></div>
    <button type="button" id="hero-next" class="ml-1 flex h-10 w-10 items-center justify-center rounded-full border border-white/50 text-white hover:bg-white/10 transition-colors" aria-label="Sonraki slayt">
      <span class="text-lg font-normal leading-none" aria-hidden="true"><img src="{{ 'icons/right-arrow.svg' | asset_url }}" width="24" height="24" alt="" loading="lazy"></span>
    </button>
  </div>
</section>
<div class="hero-scroll-spacer" aria-hidden="true"></div>

{% schema %}
{
  "name": "Vitrin — hero kaydırmalı",
  "tag": "div",
  "class": "landing-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Hero vitrin"
    },
    {
      "type": "image_picker",
      "id": "hero_slide_1_image",
      "label": "Slayt 1 — görsel (video yoksa tam ekran; video varsa küçük önizleme)",
      "info": "Video açıksa poster seçilmediyse bu görsel küçük önizleme için de kullanılır."
    },
    {
      "type": "image_picker",
      "id": "hero_video_poster_image",
      "label": "Slayt 1 — video kapak (poster)"
    },
    {
      "type": "image_picker",
      "id": "hero_slide_2_image",
      "label": "Slayt 2 — görsel"
    },
    {
      "type": "image_picker",
      "id": "hero_slide_3_image",
      "label": "Slayt 3 — görsel"
    },
    {
      "type": "header",
      "content": "Video (harici URL)"
    },
    {
      "type": "paragraph",
      "content": "MP4 için Dosyalar veya CDN URL’si."
    },
    {
      "type": "url",
      "id": "hero_video_url",
      "label": "Hero ilk slayt — video URL (MP4)"
    }
  ],
  "presets": [{ "name": "Vitrin — hero kaydırmalı" }]
}
{% endschema %}
