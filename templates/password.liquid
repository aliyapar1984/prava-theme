{% layout 'password' %}

<div class="max-w-md w-full text-center">
  <p class="text-sm uppercase tracking-wide text-white/70">{{ 'password.title' | t }}</p>
  <h1 class="mt-4 text-2xl font-semibold">{{ shop.name }}</h1>

  {% form 'storefront_password', class: 'mt-10' %}
    {{ form.errors | default_errors }}
    <label class="sr-only" for="password-input">{{ 'password.password_label' | t }}</label>
    <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
      <input
        id="password-input"
        class="min-w-0 flex-1 rounded-md border border-white/30 bg-white/10 px-4 py-3 text-white placeholder:text-white/50"
        type="password"
        name="password"
        placeholder="{{ 'password.password_placeholder' | t }}"
        required
      >
      <button class="rounded-md bg-white px-6 py-3 font-medium text-black" type="submit">
        {{ 'password.enter' | t }}
      </button>
    </div>
  {% endform %}
</div>
