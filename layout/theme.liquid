<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% elsif shop.description != blank %}
    <meta name="description" content="{{ shop.description | strip_html | strip | truncate: 160 | escape }}">
  {% endif %}

  {% render 'seo-meta' %}
  {% render 'seo-schema-org' %}
  {% if template.name == 'product' %}
    {% render 'product-json-ld', product: product %}
  {% endif %}
  {{ content_for_header }}

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
  {{ 'css/style.css' | asset_url | stylesheet_tag }}

  <script>
    (function (d) {
      var s = d.createElement('script');
      s.src = 'https://cdn.tailwindcss.com';
      s.onload = function () {
        tailwind.config = {
          theme: {
            extend: {
              fontFamily: { sans: ['Sen', 'system-ui', 'sans-serif'] },
            },
          },
        };
      };
      d.head.appendChild(s);
    })(document);
  </script>
</head>
<body class="bg-black font-sans antialiased text-[14px] text-white min-h-screen flex flex-col">
  <a class="skip-to-content-link sr-only focus:not-sr-only focus:absolute focus:z-[200] focus:m-4 focus:bg-white focus:p-3 focus:text-black focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-neutral-900" href="#MainContent">
    {{ 'general.accessibility.skip_to_content' | t }}
  </a>

  {% render 'site-header' %}

  <main id="MainContent" class="flex-1 w-full" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/ScrollTrigger.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/SplitText.min.js" defer></script>
  <script defer>
    window.PRAVA_I18N = { slide_aria: {{ 'general.pagination.slide' | t | default: 'Slayt' | json }} };
  </script>
  <script src="{{ 'js/main.js' | asset_url }}" defer></script>
  <script src="{{ 'js/intro-karaoke.js' | asset_url }}" defer></script>
</body>
</html>
